OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- NEW: Custom Ollama Endpoint Config ---
# Map your Ollama endpoint to litellm's custom_openai variables
CUSTOM_OPENAI_API_BASE=
CUSTOM_OPENAI_API_KEY=


# PROVIDER=custom_openai
# Default Settings
PROVIDER_EXTRACTION=deepseek	
EXTRACTOR_MODEL=deepseek-reasoner
PROVIDER_SYNTHESIS=deepseek
SYNTHESIZER_MODEL=deepseek-chat

JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-flash



# LLM Parameters
TEMPERATURE=0.2
MAX_RETRIES=3

# Performance
MAX_PARALLEL_EXTRACTIONS=5

# Agent-specific temperatures
LIBRARIAN_TEMPERATURE=0.3
LIBRARIAN_SUMMARY_TEMPERATURE=0.5
FACT_CHECKER_TEMPERATURE=0.3
CRITIC_TEMPERATURE=0.6

# LLM Token limits (per model family)
TOKEN_LIMIT_GPT4O=16384
TOKEN_LIMIT_GPT4=4096
TOKEN_LIMIT_REASONER=32768
TOKEN_LIMIT_GEMINI=32768
TOKEN_LIMIT_DEFAULT=8192
TOKEN_LIMIT_CUSTOM_OPENAI=16384

# Timeouts
LLM_TIMEOUT=300
API_TIMEOUT=30

# Content limits
MAX_CONTENT_TOKENS=100000

# Rate limiting
ARXIV_MIN_REQUEST_INTERVAL=3.0
LIBRARIAN_PRE_SEARCH_DELAY=1.0
LIBRARIAN_RETRY_DELAY=2.0

# Batch processing
BATCH_MAX_WORKERS=4

# Cost thresholds
COST_WARNING_PER_PAPER=1.0

# JSON retries
CRITIC_MAX_JSON_RETRIES=3
FACT_CHECKER_MAX_RETRIES=2

# https://docs.claude.com/en/docs/about-claude/models/overview
# smart
#claude-sonnet-4-5

# fast
# claude-haiku-4-5

# exceptional
# claude-opus-4-1


#####
## Literature Grounding Configuration
##
## Priority Order
## The flags are checked in this order (higher priority first):

## --no-literature CLI flag (highest)
## LITERATURE_GROUNDING_ENABLED environment variable
## enabled: true/false in config/literature_sources.yaml (lowest)
#####

##There are three ways to enable/disable literature grounding:

## 1. Configuration File (config/literature_sources.yaml)

# Set this at the top of the file
##enabled: false  # Disable literature grounding

##2. Environment Variable

# Disable for a specific run
LITERATURE_GROUNDING_ENABLED=false 
## python run_review_literature.py run_dir1

# Or export to set globally
#export LITERATURE_GROUNDING_ENABLED=false

#3. Command-Line Flag

# Use the --no-literature flag
# python run_review_literature.py run_dir1 --no-literature
